{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfirst.io/schema/lifepackage/v1",
  "title": "Life Package",
  "description": "Open, human-readable source format for a local-first life package. A property graph of people, roles, locations, items, guides, guide groups, and attachments.",
  "type": "object",
  "required": ["schema", "package", "people", "locations", "items", "guides"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "Format identifier and version.",
      "const": "lifepackage/v1"
    },
    "package": { "$ref": "#/$defs/package" },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
    "people": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "guides": { "type": "array", "items": { "$ref": "#/$defs/guide" } },
    "guide_groups": { "type": "array", "items": { "$ref": "#/$defs/guideGroup" } },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
    "readiness_checks": { "type": "array", "items": { "$ref": "#/$defs/readinessCheck" } },
    "readiness_runs": { "type": "array", "items": { "$ref": "#/$defs/readinessRun" } },
    "folders": {
      "type": "array",
      "description": "Legacy import compatibility only. Current packages should use guide_groups.",
      "items": { "$ref": "#/$defs/legacyFolder" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "description": "Stable, human-readable identifier, e.g. person_amanda or item_trezor.",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "lang": {
      "type": "string",
      "description": "BCP-47 language code, lowercase, e.g. en, sk, de.",
      "pattern": "^[a-z]{2}(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "description": "ISO-8601 calendar date (YYYY-MM-DD).",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "importance": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "order": {
      "type": "number",
      "description": "Manual sort position set by the plan author."
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "package": {
      "type": "object",
      "required": ["id", "title", "updated", "languages", "default_language"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "owner_id": {
          "$ref": "#/$defs/id",
          "description": "The single person who owns/prepared the plan."
        },
        "created": { "$ref": "#/$defs/date" },
        "updated": { "$ref": "#/$defs/date" },
        "languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/lang" },
          "minItems": 1
        },
        "default_language": { "$ref": "#/$defs/lang" },
        "primary_person_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "map_audience_roles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Roles allowed to see the Map. Empty or missing means everyone can see it."
        },
        "map_audience_person_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "Specific people allowed to see the Map. Empty or missing means everyone can see it."
        },
        "notes": { "type": "string" },
        "demo_story": { "type": "string" }
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "contact": {
      "type": "object",
      "required": ["method", "value"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": ["email", "phone", "signal", "whatsapp", "telegram", "linkedin", "address", "url", "other"]
        },
        "value": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "person": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "display_as": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "readiness_score": { "type": "string" },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question": { "type": "string" },
            "answer_hint": { "type": "string" }
          }
        },
        "importance": { "$ref": "#/$defs/importance" },
        "notes": { "type": "string" },
        "sensitive": { "type": "boolean" }
      }
    },
    "location": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "parent_id": { "$ref": "#/$defs/id" },
        "access_person_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "depends_on_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "Items this location depends on, such as keys, codes, documents, or devices."
        },
        "order": { "$ref": "#/$defs/order" },
        "notes": { "type": "string" },
        "importance": { "$ref": "#/$defs/importance" }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "importance": { "$ref": "#/$defs/importance" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "price": { "type": ["string", "number", "boolean"] },
        "location_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "container_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "access_person_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "depends_on_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "guide_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "attachment_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "sensitive": { "type": "boolean", "default": false, "description": "Handle-with-care badge. The item describes where a secret lives; it never holds the secret itself." },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "type": {
          "type": "string",
          "description": "Legacy import compatibility only. Current UI does not expose item type."
        },
        "order": {
          "$ref": "#/$defs/order",
          "description": "Legacy import compatibility only. Current item ordering is list-driven."
        }
      }
    },
    "guide": {
      "type": "object",
      "required": ["id", "title", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "group": { "type": "string" },
        "order": { "$ref": "#/$defs/order" },
        "importance": { "$ref": "#/$defs/importance" },
        "draft": { "type": "boolean" },
        "audience_roles": { "type": "array", "items": { "type": "string" } },
        "audience_person_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "updated": { "$ref": "#/$defs/date" },
        "content": { "$ref": "#/$defs/localizedText" },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "person_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "item_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "location_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "guide_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "attachment_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        },
        "folder_id": {
          "$ref": "#/$defs/id",
          "description": "Legacy import compatibility only. Current packages should use group."
        }
      }
    },
    "guideGroup": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "order": { "$ref": "#/$defs/order" }
      }
    },
    "legacyFolder": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "parent_id": { "$ref": "#/$defs/id" }
      }
    },
    "attachment": {
      "type": "object",
      "required": ["id", "filename", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "filename": { "type": "string" },
        "original_filename": { "type": "string" },
        "path": { "type": "string" },
        "mime": { "type": "string" },
        "description": { "type": "string" },
        "item_id": { "$ref": "#/$defs/id" },
        "guide_id": { "$ref": "#/$defs/id" }
      }
    },
    "readinessCheck": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "importance": { "$ref": "#/$defs/importance" },
        "scope": { "type": "string", "enum": ["external", "internal"], "default": "external" },
        "question": { "type": "string" },
        "expected": { "type": "string" },
        "owner_notes": { "type": "string" },
        "created": { "$ref": "#/$defs/date" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "person_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "role_ids": { "type": "array", "items": { "type": "string" } },
        "related_person_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "related_item_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "related_location_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "related_guide_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "related_attachment_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "readinessRun": {
      "type": "object",
      "required": ["id", "date"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "person_id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/date" },
        "started_at": { "type": "string" },
        "submitted_at": { "type": "string" },
        "duration_ms": { "type": "number" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check_id"],
            "additionalProperties": false,
            "properties": {
              "check_id": { "$ref": "#/$defs/id" },
              "status": { "type": "string", "enum": ["pass", "fail", "blocked", "not_sure", ""] },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
